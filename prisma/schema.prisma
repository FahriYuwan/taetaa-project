generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SKU {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  type         SKUType
  productSize  Float?   @default(0) // in ml
  hppPrice     Float?   @default(0)
  sellingPrice Float? // for PACKAGE only
  stockMin     Float?   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  bomComponents     BOMComponent[]     @relation("BOMParent")
  bomUsedIn         BOMComponent[]     @relation("BOMChild")
  purchases         Purchase[]
  inventory         Inventory[]
  sales             Sale[]
  productionOutputs ProductionOutput[]
  productionInputs  ProductionInput[]
  breakages         Breakage[]
  stockOpnameItems  StockOpnameItem[]
  affiliateActivities AffiliateActivity[]
}

enum SKUType {
  RAW
  WIP
  PRODUCT
  PACKAGE
}

model BOMComponent {
  id               String            @id @default(cuid())
  parentId         String // PRODUCT or PACKAGE SKU
  childSkuId       String? // If child is another SKU (RAW or PRODUCT)
  childKemasanId   String? // If child is from MasterItemKemasan
  category         BOMCategory
  quantity         Float // qty needed per parent unit
  consumptionType  ConsumptionType   @default(AUTOMATIC)
  
  parent       SKU                 @relation("BOMParent", fields: [parentId], references: [id], onDelete: Cascade)
  childSku     SKU?                @relation("BOMChild", fields: [childSkuId], references: [id], onDelete: Cascade)
  childKemasan MasterItemKemasan?  @relation(fields: [childKemasanId], references: [id], onDelete: Cascade)

  @@index([childSkuId])
  @@index([childKemasanId])
}

enum BOMCategory {
  RAW
  PACKING
  STIKER
  SAFETY
  DUS
}

enum ConsumptionType {
  AUTOMATIC
  MANUAL
}

model MasterItemKemasan {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  category    BOMCategory
  stock       Float       @default(0)
  avgCost     Float       @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  bomUsedIn   BOMComponent[]
}

model Purchase {
  id        String   @id @default(cuid())
  date      DateTime
  skuId     String
  qty       Float
  unitPrice Float
  total     Float    @default(0)
  supplier  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sku SKU @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([skuId])
}

model Inventory {
  id        String       @id @default(cuid())
  date      DateTime
  skuId     String
  movement  Float // positive = in, negative = out
  type      MovementType // PURCHASE, PRODUCTION, SALE, ADJUSTMENT, BREAKAGE
  reference String? // reference ID (Purchase, Production, Sale ID)
  createdAt DateTime     @default(now())

  sku SKU @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([skuId])
}

enum MovementType {
  PURCHASE
  PRODUCTION
  SALE
  ADJUSTMENT
  BREAKAGE
  RETURN
  AFFILIATE_SEEDING
}

model Production {
  id        String   @id @default(cuid())
  date      DateTime
  outputId  String   @unique // FK to ProductionOutput
  outputQty Float
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  output ProductionOutput  @relation(fields: [outputId], references: [id], onDelete: Cascade)
  inputs ProductionInput[]

  @@index([date])
}

model ProductionOutput {
  id         String      @id @default(cuid())
  skuId      String
  production Production?

  sku SKU @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([skuId])
}

model ProductionInput {
  id           String     @id @default(cuid())
  productionId String
  inputSkuId   String
  qtyUsed      Float
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  inputSku     SKU        @relation(fields: [inputSkuId], references: [id], onDelete: Cascade)

  @@index([productionId])
}

model Sale {
  id         String   @id @default(cuid())
  date       DateTime
  skuId      String
  qty        Float
  unitPrice  Float
  total      Float    @default(0)
  channel    Channel // SHOPEE, TIKTOK, OFFLINE, AFFILIATE
  orderId    String?
  fee        Float    @default(0) // marketplace fee
  netRevenue Float    @default(0) // total - fee
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sku SKU @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([skuId])
}

enum Channel {
  SHOPEE
  TIKTOK
  OFFLINE
  AFFILIATE
}

model Marketing {
  id        String   @id @default(cuid())
  date      DateTime
  channel   Channel
  cost      Float
  activity  String?
  notes     String?
  createdAt DateTime @default(now())
}

model Return {
  id        String   @id @default(cuid())
  date      DateTime
  saleId    String
  qty       Float
  reason    String?
  createdAt DateTime @default(now())
}

model SKUCostHistory {
  id        String   @id @default(cuid())
  skuId     String   @unique
  avgCost   Float    @default(0) // weighted average cost
  stock     Float    @default(0) // current stock
  updatedAt DateTime @updatedAt
}

model OtherExpense {
  id        String          @id @default(cuid())
  date      DateTime
  category  ExpenseCategory
  recipient String
  amount    Float
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

enum ExpenseCategory {
  BONUS
  COMPLIMENT
  LAINNYA
}

model Breakage {
  id        String           @id @default(cuid())
  date      DateTime
  skuId     String
  qty       Float
  category  BreakageCategory
  unitPrice Float // Akan diisi otomatis dari avgCost SKUCostHistory saat simpan
  total     Float // qty * unitPrice
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sku SKU @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([skuId])
}

model StockOpname {
  id            String        @id @default(cuid())
  opnameNumber  String?       // e.g. OPN-20260916-001
  date          DateTime
  notes         String?
  status        OpnameStatus  @default(DRAFT)
  items         StockOpnameItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum OpnameStatus {
  DRAFT
  REVIEW
  POSTED
}

model StockOpnameItem {
  id              String      @id @default(cuid())
  opnameId        String
  skuId           String
  systemStock     Float
  physicalStock   Float
  diff            Float
  checked         Boolean     @default(false)
  notes           String?
  
  opname          StockOpname @relation(fields: [opnameId], references: [id], onDelete: Cascade)
  sku             SKU         @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([opnameId])
}

enum BreakageCategory {
  GAGAL_QC
  RUSAK
  HILANG
  LAINNYA
}

enum AffiliateActivityType {
  AFFILIATE
  NON_AFFILIATE
}

model AffiliateActivity {
  id              String                @id @default(cuid())
  date            DateTime
  activityType    AffiliateActivityType @default(AFFILIATE)
  accountUsername String?
  realName        String?
  skuId           String
  qty             Float
  courier         String?
  shippingCost    Float                 @default(0)
  marketplace     String?
  followers       String?
  affiliateData   String?
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  sku SKU @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([skuId])
  @@map("affiliate_activity")
}
